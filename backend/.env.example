BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_project_id.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Gemini: 6-Key Split Pool Configuration ───
# Get API keys at https://aistudio.google.com/apikey

# ANALYSIS POOL (Keys 1-2): context analysis, project context analysis
GEMINI_ANALYSIS_API_KEY=your_gemini_analysis_key_1
GEMINI_ANALYSIS_API_KEY_2=your_gemini_analysis_key_2

# GENERATION POOL (Keys 3-6): outline generation, section drafting, regeneration
GEMINI_CONTENT_API_KEY=your_gemini_content_key_1
GEMINI_CONTENT_API_KEY_2=your_gemini_content_key_2
GEMINI_API_KEY_5=your_gemini_content_key_3
GEMINI_API_KEY_6=your_gemini_content_key_4

# Fallback single key (used if specific pool keys are not provided)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
